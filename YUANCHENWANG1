# ---------- 辅助：尝试从不同 JSON 结构解析并映射字段 ----------
def normalize_api_json(json_obj):
    """
    接受 API 返回的 JSON（可能是 dict-of-objects 或 list-of-objects），
    返回一个 dict keyed by code，value 为包含期望字段的 dict。
    支持多种常见字段名（symbol/code/name/spot/near/far/inventory/profit/warehouse/reg/cancel）。
    """
    # flatten into list of candidate items
    items = []
    if isinstance(json_obj, dict):
        # If values look like objects, treat as {code: obj}
        if all(not isinstance(v, (str, int, float, list)) for v in json_obj.values()):
            for k, v in json_obj.items():
                obj = dict(v) if isinstance(v, dict) else {"value": v}
                # add code if not present
                if "code" not in obj and "symbol" not in obj and "id" not in obj:
                    obj["code"] = k
                items.append(obj)
        else:
            # maybe single object with fields
            items = [json_obj]
    elif isinstance(json_obj, list):
        items = json_obj
    else:
        return None  # unknown shape

    def extract_field(obj, candidates):
        for c in candidates:
            if c in obj and obj[c] is not None:
                return obj[c]
        return None

    result = {}
    for it in items:
        if not isinstance(it, dict):
            continue
        code = extract_field(it, ["code", "symbol", "ticker", "id"])
        # if code still None and there's a name-like and price-like, try to create a key
        if code is None:
            # fallback to name
            code = extract_field(it, ["name", "shortName"]) or f"X_{len(result)+1}"
        # normalize numeric fields
        def num_field(names):
            val = extract_field(it, names)
            try:
                return float(val) if val is not None else None
            except Exception:
                return None

        spot = num_field(["spot", "spot_price", "spotPrice", "price", "last"])
        near = num_field(["near", "near_month", "front", "front_price"])
        far = num_field(["far", "far_month", "back", "back_price"])
        inventory = num_field(["inventory", "stocks", "stock"])
        profit = num_field(["profit", "margin", "profit_per_ton"])
        warehouse = num_field(["warehouse", "warehouse_receipts", "仓单", "warehouse_amount"])
        reg = int(num_field(["reg", "register", "registered"]) or 0)
        cancel = int(num_field(["cancel", "canceled", "withdrawn"]) or 0)
        name = extract_field(it, ["name", "fullName", "contractName", "commodity"])

        # Only include if we have at least spot, near, far OR profit+inventory fields — be tolerant
        # Fill missing numeric fields with reasonable defaults (0 or NaN) to avoid crashes elsewhere
        item = {
            "name": name or code,
            "spot": spot if spot is not None else 0.0,
            "near": near if near is not None else 0.0,
            "far": far if far is not None else 0.0,
            "inventory": int(inventory or 0),
            "profit": float(profit or 0.0),
            "warehouse": int(warehouse or 0),
            "reg": int(reg or 0),
            "cancel": int(cancel or 0),
        }
        result[str(code)] = item
    return result

# ---------- 数据获取与客户端缓存（基于 st.session_state） ----------
def get_data_from_api(url, token=None, timeout=6):
    if requests is None:
        raise RuntimeError("requests 库不可用，请在环境中安装 requests: pip install requests")
    headers = {}
    if token:
        headers["Authorization"] = token if token.startswith(("Bearer ", "Basic ")) else f"Bearer {token}"
    resp = requests.get(url, headers=headers, timeout=timeout)
    resp.raise_for_status()
    return resp.json()

def load_data(api_url_value: str, token_value: str, ttl: int, fallback_to_mock: bool, force_refresh: bool):
    """
    返回标准字典格式的数据（key: code -> fields dict）。
    使用 st.session_state 做简单客户端缓存，按 api_url 区分缓存条目。
    """
    cache_key = f"api_cache::{api_url_value or 'builtin'}"
    now_ts = int(time.time())

    # init cache store
    if "api_cache_store" not in st.session_state:
        st.session_state["api_cache_store"] = {}

    store = st.session_state["api_cache_store"]

    # serve cached if not expired and not forced refresh
    if (not force_refresh) and cache_key in store:
        entry = store[cache_key]
        if ttl <= 0 or (now_ts - entry["ts"] < ttl):
            return entry["data"], entry.get("meta", {})

    # if no api_url provided -> use builtin
    if not api_url_value:
        data = builtin_mock()
        store[cache_key] = {"ts": now_ts, "data": data, "meta": {"source": "mock"}}
        return data, {"source": "mock"}

    # try fetch from API
    try:
        json_body = get_data_from_api(api_url_value, token_value)
        norm = normalize_api_json(json_body)
        if not norm:
            raise ValueError("无法解析 API 返回的 JSON 结构")
        store[cache_key] = {"ts": now_ts, "data": norm, "meta": {"source": "api", "raw_sample": None}}
        return norm, {"source": "api"}
    except Exception as e:
        # on failure, optionally fallback to mock
        if fallback_to_mock:
            data = builtin_mock()
            store[cache_key] = {"ts": now_ts, "data": data, "meta": {"source": "mock_on_error", "error": str(e)}}
            return data, {"source": "mock_on_error", "error": str(e)}
        else:
            # re-raise to allow app to show the error
            raise

